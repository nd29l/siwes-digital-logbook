# ==============================================================================
# SIWES Digital Logbook - Environment Configuration
# ==============================================================================

# SUPABASE CLIENT-SIDE CONFIGURATION (Safe for Frontend)
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API.
# In Vite applications, only variables prefixed with VITE_ are exposed to the client bundle.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# CRITICAL SECURITY NOTE:
# ❌ NEVER place the Supabase 'service_role' key in this file or any client-side code!
# The 'service_role' key bypasses Row Level Security (RLS) policies completely.
# Only use the public 'anon' key in the browser/frontend.

# AI STUDIO PLATFORM SETTINGS
# GEMINI_API_KEY: Required for Gemini AI API calls (if used server-side).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Injected at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
